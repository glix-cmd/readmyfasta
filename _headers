# Cabeceras de seguridad para Netlify y Cloudflare Pages (se aplican solas al publicar).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://biowasm.com 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' https://biowasm.com; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; manifest-src 'self'; frame-ancestors 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
